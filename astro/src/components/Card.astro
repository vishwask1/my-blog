---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";

type Props = {
  variant?: "h2" | "h3";
  showThumbnail?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showThumbnail = false,
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, thumbnail, ...props } = data;
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <p>{description}</p>
  <div class="mt-1 flex flex-wrap items-center gap-2">
    <Datetime {...props} />
    <span class="text-muted-foreground text-sm">•</span>
    <ReadingTime text={body ?? ""} variant="inline" />
  </div>
  {showThumbnail && thumbnail && (
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      aria-label={title}
      class="mt-3 block w-[70%]"
    >
      <div class="aspect-video w-full overflow-hidden">
        <Image src={thumbnail} alt={title} class="h-full w-full object-cover" />
      </div>
    </a>
  )}
</li>
