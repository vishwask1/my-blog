---
// src/components/FeedbackForm.astro
export interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const formId = `feedback-form-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="feedback-form my-8 border-t border-skin-line pt-6">
  <div id={`${formId}-wrapper`}>
    <h3 class="text-lg font-semibold mb-2">
      {compact ? "Something to say?" : "Get in touch"}
    </h3>
    <p class="text-sm text-skin-base/80 mb-4">
      Thoughts, corrections, or just want to say hello — drop a note below.
    </p>

    <form
      id={formId}
      action="https://formspree.io/f/mqpzvylr"
      method="POST"
      class="flex flex-col gap-3 max-w-md"
    >
      <input
        type="email"
        name="_replyto"
        placeholder="Your email (optional)"
        class="placeholder:text-muted-foreground/80 px-3 py-2 rounded border border-border bg-background text-foreground focus:outline-none focus:ring-1 focus:ring-accent"
      />
      <textarea
        name="message"
        required
        rows={compact ? 3 : 4}
        placeholder="Your message"
        class="placeholder:text-muted-foreground/80 px-3 py-2 rounded border border-border bg-background text-foreground focus:outline-none focus:ring-1 focus:ring-accent resize-none"
      ></textarea>

      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <button
        type="submit"
        class="self-start rounded bg-accent px-4 py-2 text-sm font-medium text-accent-foreground transition hover:opacity-90"
      >
        Send
      </button>

      <p class="feedback-error text-sm text-red-500 hidden">
        Something went wrong — please try again, or email me directly.
      </p>
    </form>
  </div>

  <div id={`${formId}-success`} class="hidden">
    <p class="text-skin-base">
      Thank you for taking a moment to write — I've received your message, and I'm grateful.
    </p>
  </div>
</section>

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  const wrapper = document.getElementById(`${formId}-wrapper`);
  const success = document.getElementById(`${formId}-success`);
  const errorMsg = form?.querySelector(".feedback-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg?.classList.add("hidden");

    const submitBtn = form.querySelector("button[type=submit]");
    if (submitBtn) submitBtn.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        wrapper.classList.add("hidden");
        success.classList.remove("hidden");
      } else {
        errorMsg?.classList.remove("hidden");
        if (submitBtn) submitBtn.disabled = false;
      }
    } catch {
      errorMsg?.classList.remove("hidden");
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>