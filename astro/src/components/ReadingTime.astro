---
type Props = {
  text?: string;
  class?: string;
  variant?: "inline" | "badge";
  wordsPerMinute?: number;
};

const {
  text = "",
  class: className = "",
  variant = "inline",
  wordsPerMinute = 200,
} = Astro.props;

const sanitized = text
  .replace(/<[^>]*>/g, " ")
  .replace(/[#*_`~]/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const wordCount = sanitized ? sanitized.split(" ").length : 0;
const minutes = Math.max(1, Math.ceil(wordCount / wordsPerMinute));
const label = `${minutes} min read`;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5",
    variant === "badge"
      ? "rounded-full border border-border bg-background/80 px-2.5 py-1 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase shadow-sm"
      : "text-sm text-muted-foreground",
    className,
  ]}
>
  <span class="bg-accent h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
  {label}
</span>
