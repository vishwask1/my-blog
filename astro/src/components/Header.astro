---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const topicLinks = (await import("@/utils/getUniqueCategories")).getUniqueCategories(posts).map(({ label, slug }) => ({
  label,
  href: `categories/${slug}`,
}));

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const isCategoryActive = (category: string) =>
  currentPath === `/categories/${category}`;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div
    class="border-border bg-background relative grid w-full grid-cols-[1fr_auto] items-center border-b py-3 sm:grid-cols-[1fr_auto_1fr] sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="justify-self-start text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      {site.title}
    </a>

    <nav
      id="nav-menu"
      class="col-span-2 row-start-2 w-full justify-self-stretch sm:col-auto sm:row-auto sm:w-auto sm:justify-self-center"
    >
      <button
        id="menu-btn"
        class="focus-outline w-full border-t border-border p-2 text-start sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="border-border bg-background [&>li>a]:hover:text-accent [&>li>button]:hover:text-accent absolute inset-x-0 top-full z-30 mt-0 hidden w-full grid-cols-1 gap-2 border-b px-4 py-3 text-start shadow-sm sm:static sm:mt-0 sm:flex sm:w-auto sm:grid-cols-none sm:items-center sm:justify-center sm:gap-x-2 sm:gap-y-1 sm:border-0 sm:p-0 sm:text-center sm:shadow-none [&>li>a]:block [&>li>a]:px-2 [&>li>a]:py-1.5 [&>li>a]:text-start [&>li>a]:font-medium sm:[&>li>a]:px-2 sm:[&>li>a]:py-1.5 sm:[&>li>a]:text-center [&>li>button]:block [&>li>button]:px-2 [&>li>button]:py-1.5 [&>li>button]:text-start [&>li>button]:font-medium sm:[&>li>button]:px-2 sm:[&>li>button]:py-1.5 sm:[&>li>button]:text-center"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
          >
            {t.nav.posts}
          </a>
        </li>
        <li class="relative">
          <button
            id="topics-toggle"
            type="button"
            class="focus-outline inline-flex items-center gap-1.5 rounded-md px-1.5 py-1.5 text-base transition-colors hover:text-accent"
            aria-expanded="false"
            aria-controls="topics-menu"
            aria-label={t.nav.filterByTopic}
          >
            <span>{t.nav.filterByTopic}</span>
            <span aria-hidden="true" class="text-sm leading-none">▾</span>
          </button>
          <ul
            id="topics-menu"
            class="border-border bg-background absolute left-0 z-20 mt-2 hidden min-w-32 rounded-md border p-2 shadow-sm"
          >
            {topicLinks.map(({ label, href }) => (
              <li class="whitespace-nowrap">
                <a
                  href={getRelativeLocaleUrl(locale, href)}
                  class:list={{ "active-nav": isCategoryActive(href.split("/").at(-1) ?? "") }}
                  class="block rounded-sm px-2 py-1.5 text-sm transition-colors hover:text-accent"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>
    </nav>

    <div class="justify-self-end">
      <ul class="flex items-center gap-1">
        <li class="flex items-center gap-1">
          <a
            href={getRelativeLocaleUrl(locale, "favorites")}
            class:list={[
              "focus-outline inline-flex size-7 shrink-0 items-center justify-center rounded-full",
              { "active-nav": isActive("/favorites") },
            ]}
            title="Favorites"
            aria-label="Favorites"
          >
            <span aria-hidden="true" class="text-base leading-none">★</span>
            <span class="sr-only">Favorites</span>
          </a>
          {
            features.showArchives && (
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline relative flex size-7 shrink-0 justify-center p-0 sm:size-8",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-sm:hidden sm:absolute sm:bottom-0 sm:w-6"
                  />
                )}
              </LinkButton>
            )
          }
          {
            features.search !== false && (
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-7 shrink-0"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                  />
                )}
              </LinkButton>
            )
          }
          {
            features.lightAndDarkMode && (
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-accent relative size-7 shrink-0 p-1 sm:size-7 sm:p-0"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            )
          }
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function toggleTopicsMenu() {
    const topicsToggle = document.querySelector<HTMLButtonElement>("#topics-toggle");
    const topicsMenu = document.querySelector<HTMLUListElement>("#topics-menu");

    if (!topicsToggle || !topicsMenu) return;

    topicsToggle.addEventListener("click", event => {
      event.stopPropagation();
      const isExpanded = topicsToggle.getAttribute("aria-expanded") === "true";
      topicsToggle.setAttribute("aria-expanded", String(!isExpanded));
      topicsMenu.classList.toggle("hidden", isExpanded);
    });

    document.addEventListener("click", event => {
      const target = event.target as Node;
      if (!topicsToggle.contains(target) && !topicsMenu.contains(target)) {
        topicsToggle.setAttribute("aria-expanded", "false");
        topicsMenu.classList.add("hidden");
      }
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  toggleTopicsMenu();
  document.addEventListener("astro:after-swap", toggleTopicsMenu);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
