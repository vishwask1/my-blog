---
import type { CollectionEntry } from "astro:content";
import Datetime from "@/components/Datetime.astro";
import ReadingTime from "@/components/ReadingTime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";

type Props = {
  currentPost: CollectionEntry<"posts">;
  posts: CollectionEntry<"posts">[];
};

const { currentPost, posts } = Astro.props;
const currentCategories = new Set(slugifyAll(currentPost.data.categories ?? []));
const currentTags = new Set(slugifyAll(currentPost.data.tags ?? []));

const relatedPosts = getSortedPosts(
  posts.filter(post => post.id !== currentPost.id)
).filter(post => {
  const postCategories = new Set(slugifyAll(post.data.categories ?? []));
  const postTags = new Set(slugifyAll(post.data.tags ?? []));

  return (
    [...currentCategories].some(category => postCategories.has(category)) ||
    [...currentTags].some(tag => postTags.has(tag))
  );
});

const recommendedPosts = relatedPosts.length > 0 ? relatedPosts : getSortedPosts(posts.filter(post => post.id !== currentPost.id)).slice(0, 3);
---

{
  recommendedPosts.length > 0 && (
    <section class="my-8 border-border border-t pt-8" data-pagefind-ignore>
      <h2 class="mb-4 text-xl font-semibold">Read next</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {recommendedPosts.slice(0, 3).map(post => (
          <a
            href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}
            class="group rounded border border-border bg-background p-4 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <div class="mb-2 flex items-center gap-2 text-[11px] uppercase tracking-[0.08em] text-muted-foreground">
              <span>{post.data.categories[0] ?? "Note"}</span>
              <span aria-hidden="true">•</span>
              <ReadingTime text={post.body ?? ""} variant="inline" />
            </div>
            <h3 class="text-accent text-base font-medium group-hover:underline">
              {post.data.title}
            </h3>
            <div class="mt-3 flex items-center gap-2 text-sm text-muted-foreground">
              <Datetime {...post.data} />
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
