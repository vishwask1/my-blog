---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const categoryNames = [...new Set(filteredPosts.flatMap(post => post.data.categories))].sort((a, b) => a.localeCompare(b));
const categoryCounts = Object.fromEntries(
  categoryNames.map(category => [
    slugifyStr(category),
    filteredPosts.filter(post => post.data.categories.includes(category)).length,
  ])
);
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    <div class="mb-8 flex flex-wrap gap-2">
      <button
        type="button"
        class="archive-filter-btn is-active"
        data-filter="all"
      >
        All
      </button>
      {categoryNames.map(category => (
        <button
          type="button"
          class="archive-filter-btn"
          data-filter={slugifyStr(category)}
        >
          {category}
          <span class="text-[10px] opacity-70">({categoryCounts[slugifyStr(category)] ?? 0})</span>
        </button>
      ))}
    </div>

    {
      Object.entries(
        getPostsByGroupCondition(filteredPosts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div class="archive-year-group">
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="archive-month-group ms-6 flex flex-col sm:ms-10 sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <div
                          class="archive-item"
                          data-category={data.data.categories
                            .map(category => slugifyStr(category))
                            .join(" ")}
                          data-tags={data.data.tags
                            .map(tag => slugifyStr(tag))
                            .join(" ")}
                        >
                          <Card {...data} />
                        </div>
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>

  <Footer />
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".archive-filter-btn"
  );
  const archiveItems = document.querySelectorAll<HTMLElement>(".archive-item");
  const archiveMonthGroups = document.querySelectorAll<HTMLElement>(
    ".archive-month-group"
  );
  const archiveYearGroups = document.querySelectorAll<HTMLElement>(
    ".archive-year-group"
  );

  function applyFilters(currentFilter: string) {
    let visibleCount = 0;

    archiveItems.forEach(item => {
      const categoryValues = (item.dataset.category || "")
        .split(" ")
        .filter(Boolean);
      const tagValues = (item.dataset.tags || "").split(" ").filter(Boolean);
      const matches =
        currentFilter === "all" ||
        categoryValues.includes(currentFilter) ||
        tagValues.includes(currentFilter);

      item.style.display = matches ? "" : "none";
      if (matches) visibleCount += 1;
    });

    archiveMonthGroups.forEach(group => {
      const monthItems = group.querySelectorAll<HTMLElement>(".archive-item");
      const hasVisibleItems = Array.from(monthItems).some(
        item => item.style.display !== "none"
      );
      group.style.display = hasVisibleItems ? "" : "none";
    });

    archiveYearGroups.forEach(group => {
      const yearItems = group.querySelectorAll<HTMLElement>(".archive-item");
      const hasVisibleItems = Array.from(yearItems).some(
        item => item.style.display !== "none"
      );
      group.style.display = hasVisibleItems ? "" : "none";
    });

    const emptyState = document.querySelector<HTMLElement>(".archive-empty-state");
    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  filterButtons.forEach(button => {
    button.addEventListener("click", () => {
      const currentFilter = button.dataset.filter ?? "all";

      filterButtons.forEach(btn => {
        btn.classList.toggle("is-active", btn === button);
      });

      applyFilters(currentFilter);
    });
  });
</script>

<div class="archive-empty-state hidden py-8 text-muted-foreground italic">
  No posts match this category yet.
</div>
